# The nginx image runs envsubst on /etc/nginx/templates/*.template at startup,
# writing the result to /etc/nginx/conf.d/. Only defined env vars are replaced,
# so nginx's own variables ($uri, $backend...) are left alone.
server {
    listen 80;
    root /usr/share/nginx/html;

    # DNS servers from /etc/resolv.conf (Docker's 127.0.0.11 in compose, the host's on Render),
    # filled by the image's entrypoint (NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile).
    # Re-resolve every 10s so a recreated back-js container is picked up without restarting nginx.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        # A variable in proxy_pass makes nginx resolve the host per request (via resolver)
        # instead of once at startup.
        set $backend ${BACKEND_URL};
        # /api/todos -> /todos (with a variable, proxy_pass can't strip the prefix itself)
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $backend;
        # Send the backend's hostname in TLS (SNI) when BACKEND_URL is https (Render)
        proxy_ssl_server_name on;
    }
}
